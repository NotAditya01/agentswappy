# 1. Get a free key at https://aistudio.google.com/apikey
#    Required for every proof check. Without it, Check proof shows an error
#    and nothing is settled.
GEMINI_API_KEY=

# 2. (Optional) Gemini model. It must support tool calling and images.
#    Default is gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# 3. (Optional) GitHub token. Public commit checks work without one (60 requests/hour).
#    Create a token with no scopes: https://github.com/settings/tokens
GITHUB_TOKEN=

# 4. (Optional) Week 3 wallet. Week 2 settlement does not sign or broadcast.
#    Use a TEST wallet only. Never put a wallet with real money here.
WALLET_PRIVATE_KEY=

# Week 3, not read yet:
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REFRESH_TOKEN=
