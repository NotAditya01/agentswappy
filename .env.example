# 1. Get a free key at https://aistudio.google.com/apikey
#    Required for every proof check. Without it, Check proof shows an error
#    and nothing is settled.
GEMINI_API_KEY=

# 2. (Optional) Gemini model. It must support tool calling and images.
#    Default is gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# 3. (Optional) GitHub token. Public commit checks work without one (60 requests/hour).
#    Create a token with no scopes: https://github.com/settings/tokens
GITHUB_TOKEN=

# 4. (Optional) Week 3 wallet. Week 2 settlement does not sign or broadcast.
#    Use a TEST wallet only. Never put a wallet with real money here.
WALLET_PRIVATE_KEY=

# Week 3, not read yet:
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REFRESH_TOKEN=

# 5. (Optional) Upstash Redis for storage that survives restarts.
#    The Vercel Marketplace Upstash integration sets these for you.
#    UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN work too.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 6. Escrow on Base Sepolia (testnet). Deployed Oct 19, 2026.
#    Source is in contracts/. Addresses are also in deployments/base-sepolia.json.
NEXT_PUBLIC_ESCROW_ADDRESS=0x0cb3d1093AeD5E812f2f4Fd1a3cF92f93868782d
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_CHAIN_ID=84532
