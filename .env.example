# 1. Get a free key at https://aistudio.google.com/apikey
#    Required for the agent's own verdict wording and for photo checks.
#    GitHub and Strava checks still run without it and follow the proof rules.
GEMINI_API_KEY=

# 2. (Optional) Which Gemini model to use. It must support tool calling.
#    Photo checks also need a model that accepts images. gemini-flash-latest does both.
GEMINI_MODEL=gemini-flash-latest

# 3. (Optional) GitHub token. Public commit checks work without one (60 requests/hour).
#    Create a token with no scopes: https://github.com/settings/tokens
GITHUB_TOKEN=

# 4. (Optional) Use an existing wallet for the agent (private key, 0x...).
#    Leave empty and use the "Create wallet" button on the page instead.
#    Use a TEST wallet only. Never put a wallet with real money here.
#    Week 2 settlement does not sign or broadcast transactions.
WALLET_PRIVATE_KEY=

# Week 3, not read yet:
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REFRESH_TOKEN=
